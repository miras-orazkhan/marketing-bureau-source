
<div class="space-y-6">
  <div class="flex items-center justify-between flex-wrap gap-3">
    <h1 class="text-2xl font-bold">Кейсы</h1>
    <a href="/admin/cases/new" class="inline-flex items-center px-4 h-9 rounded-md bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
      Создать кейс
    </a>
  </div>

  <% if (it.cases && it.cases.length > 0) { %>
  <div class="space-y-2">
    <% it.cases.forEach(function(item) { %>
    <div class="bg-white border rounded-lg p-3 flex items-center gap-3">
      <div class="h-10 w-10 rounded-lg overflow-hidden shrink-0 bg-gray-100 flex items-center justify-center">
        <% if (item.coverImage) { %>
          <img src="<%= item.coverImage %>" alt="" class="w-full h-full object-cover">
        <% } else { %>
          <span class="text-xs text-gray-400"><%= (item.title || '?').charAt(0) %></span>
        <% } %>
      </div>
      <a href="/admin/cases/<%= item.id %>" class="flex-1 min-w-0">
        <div class="font-medium truncate"><%= item.title %></div>
        <div class="text-xs text-gray-400">
          slug: <%= item.slug %>
          <% if (item.client) { %> · <%= item.client %><% } %>
          <% if (item.results) { %> · <%= item.results %><% } %>
        </div>
      </a>
      <div class="flex items-center gap-2 shrink-0">
        <% if (item.published) { %>
        <span class="text-xs text-emerald-600 font-medium">опубл.</span>
        <% } else { %>
        <span class="text-xs text-amber-600 font-medium">черновик</span>
        <% } %>
        <button hx-delete="/api/admin/cases/<%= item.id %>/delete-html" hx-target="closest .bg-white" hx-swap="outerHTML" hx-confirm="Удалить кейс?"
                class="text-red-400 hover:text-red-600 transition-colors p-1" title="Удалить">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="3 6 5 6 21 6"/><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
        </button>
      </div>
    </div>
    <% }) %>
  </div>
  <% } else { %>
  <div class="text-center py-16 border border-dashed rounded-lg">
    <p class="text-gray-400 mb-4">Пока нет кейсов. Создайте первый!</p>
    <a href="/admin/cases/new" class="inline-flex items-center px-4 h-9 rounded-md bg-emerald-500 text-white text-sm font-medium">Создать кейс</a>
  </div>
  <% } %>
</div>
