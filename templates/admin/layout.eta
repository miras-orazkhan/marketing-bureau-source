<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Админка — <%= it.pageTitle || 'Панель управления' %></title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@2.0.10" defer></script>
  <style>
    .sidebar-link.active { background-color: #10b981; color: white; }
    .sidebar-link:hover:not(.active) { background-color: #f3f4f6; }
  </style>
</head>
<body class="bg-gray-50 min-h-screen">
  <div class="flex">

    <aside class="w-64 min-h-screen bg-white border-r fixed top-0 left-0 z-30 overflow-y-auto hidden md:block">
      <div class="p-4 border-b">
        <div class="flex items-center gap-2">
          <div class="h-9 w-9 rounded-lg bg-emerald-100 flex items-center justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="text-emerald-600"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
          </div>
          <p class="text-sm font-semibold">Панель управления</p>
        </div>
      </div>

      <nav class="p-2 space-y-1">
        <a href="/admin" class="sidebar-link <%= it.activeTab === 'dashboard' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="7" height="9" x="3" y="3" rx="1"/><rect width="7" height="5" x="14" y="3" rx="1"/><rect width="7" height="9" x="14" y="12" rx="1"/><rect width="7" height="5" x="3" y="16" rx="1"/></svg>
          Дашборд
        </a>

        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 px-3 pt-3 pb-1">Контент</p>

        <a href="/admin/cases" class="sidebar-link <%= it.activeTab === 'cases' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/></svg>
          Кейсы
        </a>
        <a href="/admin/services" class="sidebar-link <%= it.activeTab === 'services' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="20" height="14" x="2" y="5" rx="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
          Услуги
        </a>
        <a href="/admin/expertise" class="sidebar-link <%= it.activeTab === 'expertise' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2 15 8.5 22 9.3l-5 4.8 1.2 7L12 17.8 5.8 21l1.2-7-5-4.8L9 8.5z"/></svg>
          Экспертиза
        </a>
        <a href="/admin/faq" class="sidebar-link <%= it.activeTab === 'faq' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M9.09 9a3 3 0 0 1 5.83 1c0 2-3 3-3 3"/><path d="M12 17h.01"/></svg>
          FAQ
        </a>
        <a href="/admin/articles" class="sidebar-link <%= it.activeTab === 'articles' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M4 22h16a2 2 0 0 0 2-2V4a2 2 0 0 0-2-2H8a2 2 0 0 0-2 2v16a2 2 0 0 1-2 2zm0 0a2 2 0 0 1-2-2v-9c0-1.1.9-2 2-2h2"/><path d="M18 14h-8M15 18h-5M10 6h8v4h-8z"/></svg>
          Статьи
        </a>
        <a href="/admin/leads" class="sidebar-link <%= it.activeTab === 'leads' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22 12h-6l-2 3h-4l-2-3H2"/><path d="M5.45 5.11 2 12v6a2 2 0 0 0 2 2h16a2 2 0 0 0 2-2v-6l-3.45-6.89A2 2 0 0 0 16.76 4H7.24a2 2 0 0 0-1.79 1.11z"/></svg>
          Заявки
        </a>
        <a href="/admin/socials" class="sidebar-link <%= it.activeTab === 'socials' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="18" cy="5" r="3"/><circle cx="6" cy="12" r="3"/><circle cx="18" cy="19" r="3"/><line x1="8.59" y1="13.51" x2="15.42" y2="17.49"/><line x1="15.41" y1="6.51" x2="8.59" y2="10.49"/></svg>
          Соцсети
        </a>

        <p class="text-[10px] font-semibold uppercase tracking-wider text-gray-400 px-3 pt-3 pb-1">Система</p>

        <a href="/admin/settings" class="sidebar-link <%= it.activeTab === 'settings' ? 'active' : '' %> w-full flex items-center gap-2 px-3 py-2.5 rounded-md text-sm font-medium transition-colors text-left">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"/><circle cx="12" cy="12" r="3"/></svg>
          Настройки
        </a>
      </nav>

      <div class="p-2 border-t mt-2 space-y-1">
        <a href="/" target="_blank" class="w-full flex items-center gap-2 px-3 py-2 rounded-md text-sm text-gray-500 hover:bg-gray-100 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
          Открыть сайт
        </a>
        <a href="/api/admin/logout-html" class="w-full flex items-center gap-2 px-3 py-2 rounded-md text-sm text-red-500 hover:bg-red-50 transition-colors">
          <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/><polyline points="16 17 21 12 16 7"/><line x1="21" y1="12" x2="9" y2="12"/></svg>
          Выйти
        </a>
      </div>
    </aside>

    <details class="md:hidden fixed top-0 left-0 z-40">
      <summary class="p-3 bg-white border-b cursor-pointer">
        <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><line x1="4" y1="6" x2="20" y2="6"/><line x1="4" y1="12" x2="20" y2="12"/><line x1="4" y1="18" x2="20" y2="18"/></svg>
      </summary>
      <aside class="w-64 min-h-[calc(100vh-48px)] bg-white border-r overflow-y-auto">
        <nav class="p-2 space-y-1">
          <a href="/admin" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Дашборд</a>
          <a href="/admin/cases" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Кейсы</a>
          <a href="/admin/services" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Услуги</a>
          <a href="/admin/expertise" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Экспертиза</a>
          <a href="/admin/faq" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">FAQ</a>
          <a href="/admin/articles" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Статьи</a>
          <a href="/admin/leads" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Заявки</a>
          <a href="/admin/socials" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Соцсети</a>
          <a href="/admin/settings" class="block px-3 py-2 rounded-md text-sm font-medium hover:bg-gray-100">Настройки</a>
          <hr class="my-2">
          <a href="/" target="_blank" class="block px-3 py-2 rounded-md text-sm text-gray-500 hover:bg-gray-100">Открыть сайт</a>
          <a href="/api/admin/logout-html" class="block px-3 py-2 rounded-md text-sm text-red-500 hover:bg-red-50">Выйти</a>
        </nav>
      </aside>
    </details>

    <main class="flex-1 md:ml-64 p-4 md:p-8 max-w-7xl">
      <%~ it.content %>
    </main>

  </div>
</body>
</html>
