
<div class="space-y-6">
  <div class="flex items-center justify-between gap-3 flex-wrap">
    <div>
      <a href="/admin/cases" class="text-sm text-gray-400 hover:text-gray-600 mb-2 inline-block">← К кейсам</a>
      <h1 class="text-2xl font-bold"><%= it.isNew ? 'Новый кейс' : 'Редактирование' %></h1>
    </div>
    <button type="submit" form="case-form" class="inline-flex items-center px-4 h-9 rounded-md bg-emerald-500 text-white text-sm font-medium hover:bg-emerald-600 transition-colors">
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-1"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
      Сохранить
    </button>
  </div>

  <form id="case-form"
        hx-post="<%= it.isNew ? '/api/admin/cases/create-html' : '/api/admin/cases/' + it.item.id + '/update-html' %>"
        hx-target="#form-result"
        hx-swap="innerHTML"
        class="space-y-4">

    <div class="bg-white border rounded-xl p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Заголовок *</label>
        <input type="text" name="title" value="<%= it.item.title || '' %>" required
               class="w-full h-10 px-3 rounded-md border border-gray-300 text-lg focus:outline-none focus:ring-2 focus:ring-emerald-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">URL (slug) *</label>
        <input type="text" name="slug" value="<%= it.item.slug || '' %>" placeholder="tehno-altyn-lombard (латиницей)"
               class="w-full h-10 px-3 rounded-md border border-gray-300 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500">
        <p class="text-xs text-gray-400 mt-1">Адрес страницы: /cases/&lt;slug&gt;. Если пусто — сгенерируется из заголовка.</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Клиент</label>
        <input type="text" name="client" value="<%= it.item.client || '' %>"
               class="w-full h-10 px-3 rounded-md border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Краткое описание</label>
        <textarea name="excerpt" rows="2" class="w-full px-3 py-2 rounded-md border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"><%= it.item.excerpt || '' %></textarea>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Результат (например: +180% узнаваемости)</label>
        <input type="text" name="results" value="<%= it.item.results || '' %>"
               class="w-full h-10 px-3 rounded-md border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
      </div>

      <div class="grid grid-cols-2 gap-4">
        <div>
          <label class="block text-sm font-medium text-gray-700 mb-1">Порядок</label>
          <input type="number" name="sortOrder" value="<%= it.item.sortOrder ?? 0 %>" min="0"
                 class="w-full h-10 px-3 rounded-md border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500">
        </div>
        <div class="flex items-end gap-4 pb-1">
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="published" <%= it.item.published !== false ? 'checked' : '' %> class="rounded">
            Опубликовано
          </label>
          <label class="flex items-center gap-2 text-sm">
            <input type="checkbox" name="featured" <%= it.item.featured ? 'checked' : '' %> class="rounded">
            Рекомендуемое
          </label>
        </div>
      </div>
    </div>

    <div class="bg-white border rounded-xl p-6 space-y-4">
      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">Содержимое (HTML)</label>
        <textarea name="content" rows="10"
                  class="w-full px-3 py-2 rounded-md border border-gray-300 text-sm font-mono focus:outline-none focus:ring-2 focus:ring-emerald-500"
                  placeholder="<p>Описание кейса...</p>"><%= it.item.content || '' %></textarea>
        <p class="text-xs text-gray-400 mt-1">Поддерживается HTML: &lt;p&gt;, &lt;h2&gt;, &lt;ul&gt;&lt;li&gt;, &lt;strong&gt;, &lt;br&gt;</p>
      </div>

      <div>
        <label class="block text-sm font-medium text-gray-700 mb-1">URL обложки</label>
        <div class="flex gap-2">
          <input type="text" name="coverImage" id="coverImage" value="<%= it.item.coverImage || '' %>"
                 class="flex-1 h-10 px-3 rounded-md border border-gray-300 text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500"
                 placeholder="/uploads/...">
          <label class="inline-flex items-center px-4 h-10 rounded-md border border-gray-300 hover:bg-gray-50 text-sm cursor-pointer transition-colors">
            <input type="file" accept="image/png,image/jpeg,image/webp" class="hidden"
                   hx-post="/api/admin/upload-html" hx-encoding="multipart/form-data" hx-target="#upload-result" hx-swap="innerHTML">
            Загрузить
          </label>
        </div>
        <div id="upload-result"></div>
        <% if (it.item.coverImage) { %>
        <div class="mt-2">
          <img src="<%= it.item.coverImage %>" alt="" class="w-full max-w-xs aspect-video object-cover rounded border">
        </div>
        <% } %>
      </div>
    </div>

    <div id="form-result"></div>
  </form>
</div>
