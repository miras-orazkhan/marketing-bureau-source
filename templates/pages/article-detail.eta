<% /* Детальная страница статьи */ %>
<article class="container mx-auto px-4 py-8 max-w-4xl">
  <nav class="text-sm mb-6 text-gray-400">
    <a href="/" class="hover:text-gray-600">Главная</a>
    <span class="mx-1">/</span>
    <a href="/blog" class="hover:text-gray-600">Блог</a>
    <span class="mx-1">/</span>
    <span class="text-gray-900 font-medium truncate"><%= it.article.title %></span>
  </nav>

  <a href="/blog" class="inline-flex items-center mb-6 text-sm text-gray-500 hover:text-gray-900 transition-colors">
    <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="mr-2"><path d="m12 19-7-7 7-7"/><path d="M19 12H5"/></svg>
    Назад
  </a>

  <header class="space-y-4 mb-8">
    <div class="flex items-center gap-2 flex-wrap">
      <span class="px-2 py-1 rounded-md text-xs font-medium text-white" style="background-color: <%= it.settings?.accentColor %>">
        <%= it.article.type === 'NEWS' ? 'Новость' : 'Статья' %>
      </span>
      <% if (it.article.featured) { %>
      <span class="px-2 py-1 rounded-md text-xs bg-gray-100 text-gray-600">Выбор редакции</span>
      <% } %>
    </div>
    <h1 class="text-3xl md:text-4xl font-bold leading-tight"><%= it.article.title %></h1>
    <% if (it.article.excerpt) { %>
    <p class="text-lg text-gray-500 leading-relaxed"><%= it.article.excerpt %></p>
    <% } %>
    <div class="flex items-center gap-4 flex-wrap text-sm text-gray-400 border-t pt-4">
      <% if (it.article.author) { %>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <%= it.article.author %>
      </span>
      <% } %>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
        <%= new Date(it.article.publishedAt || it.article.createdAt).toLocaleDateString('ru-RU', {day:'numeric',month:'long',year:'numeric',hour:'2-digit',minute:'2-digit'}) %>
      </span>
      <% if (it.article.viewCount) { %>
      <span class="flex items-center gap-1">
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/><circle cx="12" cy="12" r="3"/></svg>
        <%= it.article.viewCount %> просмотров
      </span>
      <% } %>
    </div>
  </header>

  <% if (it.article.coverImage) { %>
  <div class="aspect-[16/9] overflow-hidden rounded-lg mb-8">
    <img src="<%= it.article.coverImage %>" alt="<%= it.article.title %>" class="w-full h-full object-cover">
  </div>
  <% } %>

  <div class="prose prose-lg max-w-none text-gray-600 leading-relaxed" style="white-space: pre-line">
    <%~ it.article.content %>
  </div>

  <% if (it.related && it.related.length > 0) { %>
  <section class="mt-12 pt-8 border-t">
    <h2 class="text-xl font-semibold mb-4">Похожие материалы</h2>
    <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
      <% it.related.forEach(function(r) { %>
      <a href="/blog/<%= encodeURIComponent(r.slug) %>" class="group text-left bg-white rounded-lg border p-4 hover:shadow-md transition-shadow">
        <div class="flex items-center gap-2 mb-2">
          <span class="px-2 py-0.5 rounded-md text-xs bg-gray-100 text-gray-600">
            <%= r.type === 'NEWS' ? 'Новость' : 'Статья' %>
          </span>
        </div>
        <h3 class="font-medium leading-tight line-clamp-2 group-hover:text-gray-900"><%= r.title %></h3>
        <p class="text-xs text-gray-400 mt-2"><%= new Date(r.publishedAt || r.createdAt).toLocaleDateString('ru-RU') %></p>
      </a>
      <% }) %>
    </div>
  </section>
  <% } %>
</article>
