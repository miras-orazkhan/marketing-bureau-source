<% /* Страница Блог (список статей) */ %>
<div class="container mx-auto px-4 py-8 max-w-4xl">
  <nav class="text-sm mb-6 text-gray-400">
    <a href="/" class="hover:text-gray-600">Главная</a>
    <span class="mx-1">/</span>
    <span class="text-gray-900 font-medium">Блог</span>
  </nav>

  <header class="mb-10">
    <h1 class="text-3xl md:text-4xl font-bold mb-4" style="color: <%= it.settings?.primaryColor %>">
      <%= it.settings?.blogSectionTitle || 'Блог' %>
    </h1>
    <p class="text-gray-500 leading-relaxed">Статьи о маркетинге, кейсах и трендах</p>
  </header>

  <% if (it.articles && it.articles.length > 0) { %>
  <div class="space-y-6">
    <% it.articles.forEach(function(article) { %>
    <a href="/blog/<%= encodeURIComponent(article.slug) %>" class="group block bg-white border rounded-xl overflow-hidden hover:shadow-lg transition-shadow">
      <div class="grid grid-cols-1 md:grid-cols-4 gap-0">
        <% if (article.coverImage) { %>
        <div class="md:col-span-1 aspect-[16/10] md:aspect-auto overflow-hidden">
          <img src="<%= article.coverImage %>" alt="<%= article.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500" loading="lazy" decoding="async">
        </div>
        <% } %>
        <div class="md:col-span-<%= article.coverImage ? '3' : '4' %> p-5">
          <div class="flex items-center gap-2 mb-2">
            <span class="px-2 py-0.5 rounded-md text-xs font-medium text-white" style="background-color: <%= it.settings?.accentColor %>">
              <%= article.type === 'NEWS' ? 'Новость' : 'Статья' %>
            </span>
            <% if (article.featured) { %>
            <span class="px-2 py-0.5 rounded-md text-xs bg-gray-100 text-gray-600">Выбор редакции</span>
            <% } %>
          </div>
          <h2 class="text-lg font-bold mb-2 group-hover:underline" style="color: <%= it.settings?.primaryColor %>">
            <%= article.title %>
          </h2>
          <% if (article.excerpt) { %>
          <p class="text-sm text-gray-500 line-clamp-2 mb-3"><%= article.excerpt %></p>
          <% } %>
          <div class="flex items-center gap-3 text-xs text-gray-400">
            <% if (article.author) { %><span><%= article.author %></span><% } %>
            <span><%= new Date(article.publishedAt || article.createdAt).toLocaleDateString('ru-RU', {day:'numeric',month:'long',year:'numeric'}) %></span>
            <% if (article.viewCount) { %><span><%= article.viewCount %> просмотров</span><% } %>
          </div>
        </div>
      </div>
    </a>
    <% }) %>
  </div>
  <% } else { %>
  <p class="text-center text-gray-400 py-16 border border-dashed rounded-lg">Статьи скоро появятся.</p>
  <% } %>
</div>
