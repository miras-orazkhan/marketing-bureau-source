<% /* Страница FAQ */ %>
<div class="container mx-auto px-4 py-8 max-w-3xl">
  <nav class="text-sm mb-6 text-gray-400">
    <a href="/" class="hover:text-gray-600">Главная</a>
    <span class="mx-1">/</span>
    <span class="text-gray-900 font-medium">FAQ</span>
  </nav>

  <header class="text-center mb-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-4" style="color: <%= it.settings?.primaryColor %>">
      <%= it.settings?.faqSectionTitle || 'Частые вопросы' %>
    </h1>
    <% if (it.settings?.faqSectionText) { %>
    <div class="text-gray-500 leading-relaxed prose prose-sm max-w-none">
      <%~ it.settings.faqSectionText %>
    </div>
    <% } %>
  </header>

  <% if (it.faq && it.faq.length > 0) { %>
  <div class="space-y-3">
    <% it.faq.forEach(function(item) { %>
    <details class="border rounded-lg px-5 bg-white shadow-sm hover:shadow-md transition-shadow group">
      <summary class="cursor-pointer py-4 font-medium text-left flex items-center justify-between gap-4 list-none">
        <span><%= item.question %></span>
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" class="shrink-0 transition-transform group-open:rotate-180"><polyline points="6 9 12 15 18 9"/></svg>
      </summary>
      <div class="pb-4 text-sm text-gray-500 leading-relaxed prose prose-sm max-w-none">
        <%~ item.answer %>
      </div>
    </details>
    <% }) %>
  </div>
  <% } else { %>
  <p class="text-center text-gray-400 py-16 border border-dashed rounded-lg">Вопросы скоро появятся.</p>
  <% } %>
</div>

<section class="py-16">
  <div class="container mx-auto px-4 max-w-5xl">
    <div class="rounded-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-2">
      <div class="p-8 md:p-12 text-white" style="background: linear-gradient(135deg, <%= it.settings?.primaryColor %> 0%, <%= it.settings?.accentColor %> 100%)">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Готовы обсудить ваш проект?</h2>
        <p class="text-white/90 mb-6">Оставьте заявку — проведём бесплатную консультацию.</p>
        <a href="/#cta" class="inline-flex items-center px-6 h-10 rounded-md bg-white text-gray-900 hover:bg-white/90 text-sm font-medium">Оставить заявку</a>
      </div>
      <div class="bg-white p-8 md:p-12 flex items-center">
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= it.settings?.accentColor %>"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm">Бесплатная консультация — 30 минут</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= it.settings?.accentColor %>"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm">Ответим в течение рабочего дня</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
