<% /* Страница Услуги */ %>
<div class="container mx-auto px-4 py-8 max-w-6xl">
  <nav class="text-sm mb-6 text-gray-400">
    <a href="/" class="hover:text-gray-600">Главная</a>
    <span class="mx-1">/</span>
    <span class="text-gray-900 font-medium">Услуги</span>
  </nav>

  <header class="text-center max-w-2xl mx-auto mb-12">
    <h1 class="text-3xl md:text-4xl font-bold mb-4" style="color: <%= it.settings?.primaryColor %>">
      <%= it.settings?.servicesSectionTitle || 'Услуги' %>
    </h1>
    <% if (it.settings?.servicesSectionText) { %>
    <div class="text-gray-500 leading-relaxed prose prose-sm max-w-none">
      <%~ it.settings.servicesSectionText %>
    </div>
    <% } %>
  </header>

  <% if (it.services && it.services.length > 0) { %>
  <div class="space-y-6">
    <% it.services.forEach(function(item) { %>
    <article class="bg-white border rounded-xl p-6 md:p-8 grid grid-cols-1 md:grid-cols-3 gap-6">
      <div class="md:col-span-1 space-y-3">
        <div class="h-14 w-14 rounded-lg flex items-center justify-center overflow-hidden"
             style="background-color: <%= it.settings?.accentColor %>1a">
          <% if (item.iconImage) { %>
            <img src="<%= item.iconImage %>" alt="<%= item.title %>" class="h-14 w-14 object-cover rounded-lg" loading="lazy" decoding="async">
          <% } else { %>
            <%~ it.iconSvg(item.icon, 'h-7 w-7', it.settings?.accentColor) %>
          <% } %>
        </div>
        <h2 class="text-xl font-bold" style="color: <%= it.settings?.primaryColor %>">
          <%= item.title %>
        </h2>
        <% if (item.excerpt) { %>
        <p class="text-sm text-gray-500"><%= item.excerpt %></p>
        <% } %>
      </div>
      <div class="md:col-span-2">
        <% if (item.content) { %>
        <div class="prose prose-sm max-w-none text-gray-600 leading-relaxed" style="white-space: pre-line">
          <%~ item.content %>
        </div>
        <% } else { %>
        <p class="text-sm text-gray-500">Подробное описание услуги скоро появится.</p>
        <% } %>
      </div>
    </article>
    <% }) %>
  </div>
  <% } else { %>
  <p class="text-center text-gray-400 py-16 border border-dashed rounded-lg">Услуги скоро появятся.</p>
  <% } %>
</div>

<section class="py-16">
  <div class="container mx-auto px-4 max-w-5xl">
    <div class="rounded-2xl overflow-hidden grid grid-cols-1 lg:grid-cols-2">
      <div class="p-8 md:p-12 text-white"
           style="background: linear-gradient(135deg, <%= it.settings?.primaryColor || '#0f172a' %> 0%, <%= it.settings?.accentColor || '#10b981' %> 100%)">
        <h2 class="text-2xl md:text-3xl font-bold mb-3">Готовы обсудить ваш проект?</h2>
        <p class="text-white/90 mb-6">Оставьте заявку — проведём бесплатную консультацию.</p>
        <a href="/#cta" class="inline-flex items-center px-6 h-10 rounded-md bg-white text-gray-900 hover:bg-white/90 text-sm font-medium">
          Оставить заявку
        </a>
      </div>
      <div class="bg-white p-8 md:p-12 flex items-center">
        <div class="space-y-3">
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= it.settings?.accentColor %>"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm">Бесплатная консультация — 30 минут</span>
          </div>
          <div class="flex items-center gap-2">
            <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="color: <%= it.settings?.accentColor %>"><polyline points="20 6 9 17 4 12"/></svg>
            <span class="text-sm">Ответим в течение рабочего дня</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>
