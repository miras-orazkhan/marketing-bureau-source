<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= it.title || it.settings?.metaTitle || 'Marketing Bureau' %></title>
  <meta name="description" content="<%= it.description || it.settings?.metaDescription || '' %>">
  <% if (it.settings?.favicon) { %>
  <link rel="icon" href="<%= it.settings.favicon %>?v=<%= new Date(it.settings.updatedAt).getTime() %>">
  <% } else { %>
  <link rel="icon" href="/logo.svg">
  <% } %>
  <% if (it.settings?.heroBackground) { %>
  <link rel="preload" as="image" href="<%= it.settings.heroBackground %>" fetchPriority="high">
  <% } %>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/htmx.org@2.0.10" defer></script>
  <% if (it.settings?.googleTagManager) { %>
  <script>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src='https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);})(window,document,'script','dataLayer','<%= it.settings.googleTagManager %>');</script>
  <% } %>
</head>
<body class="bg-white text-gray-900 antialiased min-h-screen flex flex-col">
  <% if (it.settings?.googleTagManager) { %>
  <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=<%= it.settings.googleTagManager %>" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
  <% } %>
  <%~ it.header || '' %>
  <main id="main-content" class="flex-1">
    <%~ it.content %>
  </main>
  <%~ it.footer || '' %>
</body>
</html>
